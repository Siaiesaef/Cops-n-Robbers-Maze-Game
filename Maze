#defining a single cell
class Cell:
    def __init__(self,x,y):
        self.x=x
        self.y= y
        self.walls ={'top': True, 'right': True, 'bottom': True, 'left': True}
        self.visited= False

    def draw(self,offset_x,offset_y):
        #drawing the maze at the offsets
        x =self.x*TILE+offset_x
        y =self.y*TILE+offset_y

        if self.visited:
            pygame.draw.rect(sc,pygame.Color('#1e1e1e'),(x,y,TILE,TILE)) #drawing all edges of the cell
        if self.walls['top']:
            pygame.draw.line(sc,pygame.Color('#1e4f5b'),(x,y),(x+TILE,y),3)
        if self.walls['right']:
            pygame.draw.line(sc,pygame.Color('#1e4f5b'),(x+TILE,y),(x+TILE,y+TILE),3)
        if self.walls['bottom']:
            pygame.draw.line(sc, pygame.Color('#1e4f5b'),(x +TILE,y + TILE),(x,y+TILE),3)
        if self.walls['left']:
            pygame.draw.line(sc,pygame.Color('#1e4f5b'),(x, y+ TILE),(x,y),3)


# union-find (disjoint set) implementation
class UnionFind:
    def __init__(self,n):
        self.parent=list(range(n))

    def find(self,u):
        if self.parent[u] !=u:
            self.parent[u]=self.find(self.parent[u])
        return self.parent[u]

    def union(self,u,v):
        root_u =self.find(u)
        root_v =self.find(v)
        if root_u !=root_v:
            self.parent[root_v]=root_u
            return True
        return False

