#detect if a player/cop collides with the wall
def detect_collision(x,y):
    player_rect=pygame.Rect(x,y,player.rect.width,player.rect.height)

    #check if players next postion is towards a wall
    for corner in [(x,y),(x +player.rect.width, y),(x,y,player.rect.height)]:
        for col in range(cols):
            for row in range(rows):
                cell=grid_cells[row*cols+col]

    cop_rect=pygame.Rect(x,y,cop.rect.width,cop.rect.height)

    #check if cops next postion is towards a wall
    for corner in [(x,y),(x +cop.rect.width, y),(x,y,cop.rect.height)]:
        for col in range(cols):
            for row in range(rows):
                cell=grid_cells[row*cols+col]

    for cell in grid_cells:
        cell_rect=pygame.Rect(offset_x + cell.x *TILE, offset_y + cell.y *TILE,TILE,TILE)
        if cell.walls['top'] and player_rect.colliderect(pygame.Rect(cell_rect.left,cell_rect.top -2,TILE,2)):
            return True  # collision with top wall
        if cell.walls['bottom'] and player_rect.colliderect(pygame.Rect(cell_rect.left,cell_rect.bottom,TILE,2)):
            return True  # collision with the bottom wall
        if cell.walls['left'] and player_rect.colliderect(pygame.Rect(cell_rect.left -2,cell_rect.top,2,TILE)):
            return True  # collision with the left wall
        if cell.walls['right'] and player_rect.colliderect(pygame.Rect(cell_rect.right,cell_rect.top,2,TILE)):
            return True
        
        #check if cops colliding with any wall in a cell
        if cell.walls['top'] and cop_rect.colliderect(pygame.Rect(cell_rect.left, cell_rect.top -2,TILE,2)):
            return True #collision with top wall
        if cell.walls['bottom'] and cop_rect.colliderect(pygame.Rect(cell_rect.left, cell_rect.bottom,TILE,2)):
            return True  #collision with the bottom wall
        if cell.walls['left'] and cop_rect.colliderect(pygame.Rect(cell_rect.left -2, cell_rect.top,2,TILE)):
            return True  #collision with the left wall
        if cell.walls['right'] and cop_rect.colliderect(pygame.Rect(cell_rect.right, cell_rect.top,2,TILE)):
            return True #collision with right wall
    return False


