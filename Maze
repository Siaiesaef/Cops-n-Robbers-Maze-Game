#returns neighbouring cells that have no walls between them
def get_neighbours(cell, grid_cells, cols, rows):
    neighbours = []
    x, y = cell.x, cell.y
    index = x + y * cols
    #           Right,  Left,  Up,  Down
    directions=[(-1,0),(1,0),(0,-1),(0,1)]

    for dx,dy in directions:
        nx,ny= x + dx, y + dy
        if valid_move(nx,ny,grid_cells,cols,rows):
            neighbours.append(grid_cells[ny *cols +nx])

    if not cell.walls['top'] and y > 0:
        neighbours.append(grid_cells[index - cols])  # Top
    if not cell.walls['bottom'] and y < rows - 1:
        neighbours.append(grid_cells[index + cols])  # Bottom
    if not cell.walls['left'] and x > 0:
        neighbours.append(grid_cells[index - 1])  # Left
    if not cell.walls['right'] and x < cols - 1:
        neighbours.append(grid_cells[index + 1])  # Right

    return neighbours

