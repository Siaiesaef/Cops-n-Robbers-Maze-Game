#dijkstras algorithm
def Dijkstras(start_cell, end_cell, grid_cells, cols, rows):
    start_idx = start_cell.y * cols + start_cell.x
    end_idx = end_cell.y * cols + end_cell.x
    
    # Distance dictionary using grid index
    distances = {i: float('inf') for i in range(len(grid_cells))}
    previous_nodes = {i: None for i in range(len(grid_cells))}
    distances[start_idx] = 0
    
    # Priority queue (distance, index)
    priority_queue = [(0, start_idx)]

    while priority_queue:
        current_distance, current_idx = heapq.heappop(priority_queue)
        current_cell = grid_cells[current_idx]

        if current_idx == end_idx:
            break

        # Explore neighbors
        for neighbor in get_neighbours(current_cell, grid_cells, cols, rows):
            neighbor_idx = neighbor.y * cols + neighbor.x
            distance = current_distance + 1  # Uniform cost

            if distance < distances[neighbor_idx]:
                distances[neighbor_idx] = distance
                previous_nodes[neighbor_idx] = current_idx
                heapq.heappush(priority_queue, (distance, neighbor_idx))

    # Reconstruct path
    path = []
    current_idx = end_idx
    while current_idx is not None:
        path.insert(0, grid_cells[current_idx])
        current_idx = previous_nodes[current_idx]

    return path if path and path[0] == start_cell else []

#function to move cop smoothly along its path
def update_cop_path():
    global cop_step,cop_path

    #get start and player position on grid
    cop_start_index=(cop.rect.y//TILE)* cols +(cop.rect.x//TILE)
    player_index=(player.rect.y//TILE)* cols +(player.rect.x//TILE)

    if 0<= cop_start_index <len(grid_cells) and 0 <=player_index <len(grid_cells):
        cop_start=grid_cells[cop_start_index]
        player_position=grid_cells[player_index]

        #recalc the path if needed
        cop_path=Dijkstras(cop_start,player_position,grid_cells,cols,rows)
        cop_step=1

#cops movement towards the target
def move_cop_smoothly():
    global cop_step,cop_path

    #ensure theres a valid path and steps to follow
    if cop_path and cop_step <len(cop_path):
        next_cell=cop_path[cop_step]

        target_x=offset_x + next_cell.x *TILE +4
        target_y=offset_y + next_cell.y *TILE +4

        #calc difference between current position and target position
        diff_x=target_x - cop.rect.x
        diff_y=target_y - cop.rect.y

        move_speed=0.05

        #calc next step toward target
        next_x=cop.rect.x +diff_x *move_speed 
        next_y=cop.rect.y +diff_y *move_speed 

        if not detect_collision(next_x,next_y):
            cop.rect.x=next_x
            cop.rect.y=next_y 
        else:
            #if theres a wall dont move
            pass 

        #when cop reaches target(within margin)
        if abs(diff_x) <1 and abs(diff_y) <1:
            cop.rect.x=target_x
            cop.rect.y=target_y
            #move to the next step in path
            cop_step +=1

def valid_move(x,y,grid_cells,cols,rows):
    if 0 <= x < cols and 0 <= y <rows:
        index=y *cols +x
        cell=grid_cells[index]
        return not (cell.walls['top']or cell.walls['right']or cell.walls['bottom']or cell.walls['left'])
    return False 


